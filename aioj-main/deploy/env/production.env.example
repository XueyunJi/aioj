# Public schema only. Copy to /opt/aioj/env/app.env, set mode 0600, and replace
# every placeholder on the server. Never copy workstation values to production.

COMPOSE_PROJECT_NAME=aioj
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_DATABASE=ai_oj_next
MYSQL_USER=aioj
MYSQL_PASSWORD=replace-production-mysql-password
MYSQL_ROOT_PASSWORD=replace-production-root-password
REDIS_PASSWORD=replace-production-redis-password
RABBITMQ_DEFAULT_USER=aioj
RABBITMQ_DEFAULT_PASS=replace-production-rabbit-password

JWT_ISSUER=aioj
JWT_HMAC_SECRET=replace-with-at-least-32-random-bytes
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ACCESS_TTL=PT2H
JWT_REFRESH_TTL=P14D
AIOJ_INTERNAL_API_TOKEN=replace-with-a-distinct-random-token
SANDBOX_TOKEN=replace-with-a-distinct-random-token

AUTH_REGISTRATION_ENABLED=false
AUTH_DB_POOL_MAX=8
AUTH_DB_POOL_MIN_IDLE=2
PROBLEM_DB_POOL_MAX=12
PROBLEM_DB_POOL_MIN_IDLE=2
AI_DB_POOL_MAX=6
AI_DB_POOL_MIN_IDLE=1
JUDGE_DB_POOL_MAX=4
JUDGE_DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=5000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_INTENT_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_INTENT_MODEL=deepseek-v4-pro
KIMI_API_KEY=
KIMI_MODEL=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1/chat/completions
AI_EMBEDDING_ENABLED=false
AI_EMBEDDING_API_KEY=

AI_CHAT_CORE_POOL_SIZE=2
AI_CHAT_MAX_POOL_SIZE=4
AI_CHAT_QUEUE_CAPACITY=32
AI_STUDENT_ASSISTANT_CONCURRENCY=4
AI_PROBLEM_DRAFT_CONCURRENCY=1
AI_INTENT_MEMORY_CONCURRENCY=2
AI_BATCH_REPORT_CONCURRENCY=1

AIOJ_OPERATION_EXECUTOR_POOL_SIZE=2
AIOJ_OPERATION_POLL_BATCH_SIZE=3
AIOJ_PLAGIARISM_EXECUTOR_POOL_SIZE=1
AIOJ_CONTEST_INVITATION_DISPATCH_CONCURRENCY=2
AIOJ_CONTEST_INVITATION_DISPATCH_BATCH_SIZE=25
AIOJ_CONTEST_INVITATION_DISPATCH_POLL_MILLIS=5000

SANDBOX_OUTPUT_LIMIT=33554432
SANDBOX_COPY_OUT_LIMIT=16777216
SANDBOX_FILE_TIMEOUT=10m
JUDGE_STDOUT_BASE_COLLECT_LIMIT_BYTES=65536
JUDGE_STDOUT_EXTRA_COLLECT_BYTES=65536
JUDGE_STDOUT_MAX_COLLECT_LIMIT_BYTES=4194304
JUDGE_STDERR_COLLECT_LIMIT_BYTES=65536

GATEWAY_PORT=8101
WEB_USER_PORT=5173
WEB_ADMIN_PORT=5174
VITE_API_BASE_URL=/api
CORS_ALLOWED_ORIGINS=https://student.example.edu,https://admin.example.edu
GATEWAY_RESPONSE_TIMEOUT=240s
AI_GATEWAY_RESPONSE_TIMEOUT_MS=900000
GATEWAY_CONNECT_TIMEOUT_MS=10000
